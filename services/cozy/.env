#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name. Used as hostname in Tailscale and for container naming.
# Use letters and digits only, with no hyphen: cozy-stack joins the instance name and the app name with a hyphen.
# The apps get their own devices, named after the service: the service name, then -home, -settings, or -drive.
SERVICE=cozy
# Docker image URL from container registry.
IMAGE_URL=cozy/cozy-stack:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=8080
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
# The same key is used for all four devices of this stack, so it must be reusable.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# CouchDB
COUCHDB_USER=cozy
# Required: password of the CouchDB database. Use letters and digits only, because it is part of an address. Generate it with: openssl rand -hex 24
COUCHDB_PASSWORD=

# cozy-stack
# Required: administrator passphrase for the cozy-stack command line, stored as a hash at the first start. Generate it with: openssl rand -hex 24
COZY_ADMIN_PASSPHRASE=
