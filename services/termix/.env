#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=termix
IMAGE_URL=ghcr.io/lukegus/termix:latest

# Network Configuration
SERVICEPORT=8080
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Termix Configuration
# HTTP server port inside the container.
PORT=8080
# Remote desktop (RDP/VNC/Telnet) via guacd. Default false: SSH/terminal works standalone.
# To enable, uncomment the `guacd` service in compose.yaml and set this to true,
# then turn on the RDP/VNC/Telnet toggle in Admin Settings (guacd URL localhost:4822).
ENABLE_GUACAMOLE=false

# --- External database (optional, instead of SQLite) ---
# SQLite is the default and needs no setup. For PostgreSQL or MySQL, set:
#DATABASE_DIALECT=postgres # sqlite (default), postgres, or mysql
#DATABASE_URL=postgres://termix:"REPLACE_WITH_DB_PASSWORD"@localhost:5432/termix
# Keep the data volume either way: Termix still uses it for keys, certificates, and recordings.
