#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=docmost
IMAGE_URL=docmost/docmost

# Network Configuration
SERVICEPORT=3000
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Optional Service variables
# PUID=1000

# Required: at least 32 characters. Generate with: openssl rand -hex 32
APP_SECRET=
# Required: password for the Docmost PostgreSQL user. Use letters and digits only, because it is part of DATABASE_URL.
# PostgreSQL applies it only when the database is first created. Existing installations must keep their current password.
DB_PASSWORD=

#EXAMPLE_VAR="Environment variable"
