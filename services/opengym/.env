#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=opengym
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=ghcr.io/duartesantos8/opengym-web:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=8080
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: your Tailnet name, the part between the service name and ".ts.net" in https://opengym.<tailnet name>.ts.net, for example tail1234.
# Passkeys are bound to this address. If you change it later, existing passkeys stop working.
TAILNET_NAME=

# Optional: name shown in the passkey prompt.
RP_NAME=openGym
# Optional: set to 1 so that the first profile created on a new instance becomes its admin. Create your own profile before you share the address.
FIRST_USER_ADMIN=
# Optional: comma-separated account IDs of more admins. Find an ID under Settings > Account > Account ID.
ADMIN_UIDS=
# Optional: set to 1 to require an invite code for new profiles. Create your own profile first.
INVITE_ONLY=
# Optional: set to 0 to remove the "Continue without account" button.
ALLOW_GUEST=
# Optional: set to 1 to add sign-in with a name and password next to passkeys.
PASSWORD_LOGIN=
# Optional: language code for the sign-in screen and new profiles, such as de, fr, or pt-BR.
DEFAULT_LANG=
