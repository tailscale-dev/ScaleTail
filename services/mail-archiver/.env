#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming (app-${SERVICE}).
SERVICE=mail-archiver
# Docker image URL from container registry (e.g., adguard/adguard-home).
IMAGE_URL=s1t5/mailarchiver:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=5000
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.

# Tailscale Configuration
# Auth key from https://tailscale.com/admin/authkeys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Optional Service variables
# PUID=1000

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# First admin user. Required: set a password before the first start.
APP_USER=admin
APP_PW=

# Database user. Required: set a password before the first start. Use letters and digits only, because it is part of the connection string.
# PostgreSQL applies it only when the database is first created. Existing installations must keep their current password.
DB_USER=mailuser
DB_PW=

# OAuth/OIDC login (optional). Set OAUTH_SETUP to true and fill in the values from your identity provider.
OAUTH_SETUP=false
OAUTH_URL=
OAUTH_CLIENTID=
OAUTH_SECRET=
# Name shown on the login button ("Login with ...").
OAUTH_DISPLAYNAME=SSO
