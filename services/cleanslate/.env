#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=cleanslate
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
# The three Clean Slate images belong together. Update them at the same time.
IMAGE_URL=ghcr.io/successible/cleanslate/client:latest
GRAPHQL_IMAGE_URL=ghcr.io/successible/cleanslate/graphql-server:latest
AUTH_IMAGE_URL=ghcr.io/successible/cleanslate/authentication-server:latest
# PostgreSQL major version. Do not change it on an existing database without a dump and restore.
DB_IMAGE_URL=postgres:15

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=3000
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: password of the administrator of the Hasura console. Generate it with: openssl rand -hex 32
HASURA_GRAPHQL_ADMIN_SECRET=
# Required: key that signs the login tokens. Hasura needs at least 32 characters. Generate it with: openssl rand -hex 32
JWT_SIGNING_SECRET=
# Required: password of the PostgreSQL user. Generate it with: openssl rand -hex 32
# PostgreSQL applies it only when the database is first created. Use letters and digits only, because it is part of the database address.
POSTGRES_PASSWORD=

# Optional: the origin that may call the API from a browser, for example https://cleanslate.<tailnet>.ts.net
# The default * allows any origin. The browser needs the exact address of the web interface.
HASURA_GRAPHQL_CORS_DOMAIN=*
