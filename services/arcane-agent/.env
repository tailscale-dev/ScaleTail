#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name. Used as the Tailscale hostname and in the container names.
# Give the agent on each host its own name, such as arcane-agent-nas.
SERVICE=arcane-agent
# Docker image URL from container registry. Run the same major version of Arcane as the manager.
IMAGE_URL=ghcr.io/getarcaneapp/agent:latest

# Network Configuration
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Required: the Tailnet address of your Arcane manager, such as https://arcane.tail1234.ts.net
ARCANE_MANAGER_API_URL=

# Required: an enrollment token from the Arcane manager. It starts with arc_etkn_.
ARCANE_AGENT_TOKEN=
