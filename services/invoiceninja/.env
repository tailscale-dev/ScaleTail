#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=invoiceninja
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=invoiceninja/invoiceninja-octane:5

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=80
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: your Tailnet name, the part between the service name and ".ts.net" in https://invoiceninja.<tailnet name>.ts.net, for example tail1234.
TAILNET_NAME=
# Required: encrypts sessions and stored secrets. Generate it with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Required: password of the ninja database user. Generate it with: openssl rand -hex 32
DB_PASSWORD=
# Required: password of the database root user. Generate it with: openssl rand -hex 32
DB_ROOT_PASSWORD=
# Required: email address of the first administrator, created on the first start.
IN_USER_EMAIL=
# Required: password of the first administrator, created on the first start.
IN_PASSWORD=

# Email delivery. "log" writes emails to the log instead of sending them. Set MAIL_MAILER=smtp and the values below to send them.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=user@example.com
MAIL_FROM_NAME=Invoice Ninja
