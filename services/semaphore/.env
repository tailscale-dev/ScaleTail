#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming (app-${SERVICE}).
SERVICE=semaphore
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=semaphoreui/semaphore:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=3000
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Optional Service variables
# PUID=1000

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Admin account that Semaphore creates at the first start. Later changes here have no effect.
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@localhost
# Required: password of the admin account. Generate one with: openssl rand -hex 24
SEMAPHORE_ADMIN_PASSWORD=
# Required: key that encrypts the SSH keys and passwords that Semaphore stores. Generate it with: head -c32 /dev/urandom | base64
# Keep it and never change it, or Semaphore can no longer read the secrets it stored.
SEMAPHORE_ACCESS_KEY_ENCRYPTION=
