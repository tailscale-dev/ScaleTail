#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming (app-${SERVICE}).
SERVICE=outline
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=docker.getoutline.com/outlinewiki/outline:latest

# Network Configuration
# Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
SERVICEPORT=3000
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Optional Service variables
# PUID=1000

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: your Tailnet name without .ts.net (e.g., tail1234). Outline builds its address, https://<SERVICE>.<TAILNET_NAME>.ts.net, from it.
TAILNET_NAME=
# Required: encrypts stored data and signs logins. Do not change it later, or users can no longer log in. Generate it with: openssl rand -hex 32
SECRET_KEY=
# Required: protects the internal endpoint that runs scheduled tasks. Generate it with: openssl rand -hex 32
UTILS_SECRET=
# Required: password of the PostgreSQL database. Use letters and digits only, because it is part of DATABASE_URL. Generate it with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional: email delivery, for invites, email sign-in, and notifications. Email stays off while SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address of the emails, such as user@example.com.
SMTP_FROM_EMAIL=
# true: TLS from the start, usually on port 465. false: STARTTLS when the server offers it, usually on port 587.
SMTP_SECURE=false
