#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=gotify
IMAGE_URL=gotify/server

# Network Configuration
SERVICEPORT=80
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Optional Service variables
# PUID=1000

# Gotify Configuration
# Required: password of the user admin that Gotify creates at the first start.
GOTIFY_DEFAULTUSER_PASS=

# Optional: set to igotify to also start the iGotify container for the iOS app, see the README.
COMPOSE_PROFILES=

# iGotify Configuration (only used with the igotify profile)
IGOTIFY_IMAGE_URL=ghcr.io/androidseb25/igotify-notification-assist:latest
# Set the next three values together, after you set up the iGotify app, see the README.
GOTIFY_URLS=
GOTIFY_CLIENT_TOKENS=
SECNTFY_TOKENS=

#EXAMPLE_VAR="Environment variable"
