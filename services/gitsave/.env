#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=gitsave
IMAGE_URL=timwitzdam/gitsave

# Network Configuration
SERVICEPORT=3000
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Optional Service variables
# PUID=1000

# Required: signs the login tokens. Generate it with: openssl rand -hex 32
JWT_SECRET=
DISABLE_AUTH=false
# Required: encrypts stored data. Exactly 32 characters. Generate it with: openssl rand -hex 16
ENCRYPTION_SECRET=

#EXAMPLE_VAR="Environment variable"
