#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=arcane # Service name (e.g., adguard). Used as hostname in Tailscale and for container naming (app-${SERVICE}).
# Docker image URL from container registry. Arcane 3 renamed the image from ghcr.io/getarcaneapp/arcane.
IMAGE_URL=ghcr.io/getarcaneapp/manager:latest

# Network Configuration
SERVICEPORT=3552 # Port to expose to local network. Uncomment the "ports:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9 # Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.

# Tailscale Configuration
# Auth key from https://tailscale.com/admin/authkeys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Optional Service variables
# for example: tail-scale
TAILNET_NAME=

# Required: a key of at least 32 characters. Generate it with: openssl rand -hex 32
ENCRYPTION_KEY=

# Absolute path of the folder on the host that holds your stacks, one folder per stack.
# Arcane uses the same path in its container. Create the folder before the first start.
STACKS_DIR=/opt/stacks
# User and group that own the folder in STACKS_DIR. Find them with: id -u and id -g
PUID=1000
PGID=1000

#EXAMPLE_VAR="Environment variable"
