#URL=https://github.com/tailscale-dev/ScaleTail
# To run a second copy, copy the folder under another name and change SERVICE.

# Service Configuration
# Service name (e.g., adguard). Used as hostname in Tailscale and for container naming.
SERVICE=imagemaid
# Docker image URL from container registry (e.g., adguard/adguardhome:latest).
IMAGE_URL=kometateam/imagemaid:latest

# Network Configuration
# Preferred DNS server for Tailscale. Uncomment the "dns:" section in compose.yaml to enable.
DNS_SERVER=9.9.9.9

# Tailscale Configuration
# Auth key from https://console.tailscale.com/admin/settings/keys. See: https://tailscale.com/kb/1085/auth-keys#generate-an-auth-key for instructions.
TS_AUTHKEY=

# Time Zone setting for containers. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# Any Container environment variables are declared below. See https://docs.docker.com/compose/how-tos/environment-variables/

# Required: the Plex data folder on this host, the one that contains the Cache, Metadata, and Plug-in Support folders. The stack does not start without it. Check the path before you start, because ImageMaid works on these files.
# Plex stack of this repository: ../plex/plex-data/config/Library/Application Support/Plex Media Server
# Plex on Linux: /var/lib/plexmediaserver/Library/Application Support/Plex Media Server
# Plex on macOS: /Users/<your user>/Library/Application Support/Plex Media Server
# Other installs, such as a NAS: see https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/
PLEX_DATA_DIR=
# What ImageMaid does with unused images: report (only list them), move (move them to a restore folder), or remove (delete them).
MODE=report
# When ImageMaid runs, as time|frequency, for example 05:00|weekly(sunday). Keep it set: ImageMaid runs once and exits when it is empty.
SCHEDULE=05:00|weekly(sunday)
# Address of your Plex server, for example http://100.64.0.1:32400. Leave empty, together with PLEX_TOKEN, to read the Plex database from PLEX_DATA_DIR.
PLEX_URL=
# Plex token. Leave empty to read the Plex database from PLEX_DATA_DIR. See: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=
