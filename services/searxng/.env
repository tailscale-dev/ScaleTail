#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=searxng
IMAGE_URL=docker.io/searxng/searxng

# Network Configuration
SERVICEPORT=8080
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Your Tailnet name, as in <SERVICE>.<TAILNET_NAME>.ts.net. Required: SearXNG builds its public base URL from it.
TAILNET_NAME=

# Optional Service variables
# PUID=1000

# Generate a random secret for searxng, e.g. using `openssl rand -hex 32`
SEARXNG_SECRET=
SEARXNG_VALKEY_URL=valkey://valkey:6379/0 # URL for valkey, format: valkey://<hostname>:<port>/<db>

#EXAMPLE_VAR="Environment variable"
