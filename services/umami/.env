#version=1.1
#URL=https://github.com/tailscale-dev/ScaleTail
#COMPOSE_PROJECT_NAME= # Optional: only use when running multiple deployments on the same infrastructure.

# Service Configuration
SERVICE=umami
IMAGE_URL=ghcr.io/umami-software/umami:postgresql-latest

# Network Configuration
SERVICEPORT=3001
DNS_SERVER=9.9.9.9

# Tailscale Configuration
TS_AUTHKEY=

# Optional Service variables
PUID=1000
PGID=1000

# Time Zone setting for containers
TZ=Europe/Amsterdam # See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# Generate a salt with, e.g. `openssl rand -base64 32`
APP_SECRET=your_generated_random_string_here

# Database Configuration
DB_IMAGE_URL=postgres:15-alpine
DB_NAME=umami
DB_USER=umami
DB_PASSWORD=umami

# The serve config to use.
# 'private' keeps all access to umami within your tailnet
# 'public' exposes the analytics script and api endpoint via funnel so that site that are not on the tailnet can report analytics
SERVE_CONFIG=private
# SERVE_CONFIG=public